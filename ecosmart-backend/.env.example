PORT=5000
# Cadena de conexión de Supabase (Project Settings → Database)
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
# SSL activo por defecto (Supabase lo exige). Solo para una BD local sin SSL: DATABASE_SSL=false

# Clave que debe enviar quien reporta lecturas (ESP32 / gateway).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=cambia-esto-por-una-clave-larga

# Regla de alerta (%), señal "sin reporte" (horas sin lectura) y "sin conexión" (minutos sin lectura)
UMBRAL_ALERTA=80
SIN_REPORTE_HORAS=6
SIN_CONEXION_MIN=25

# --- Firebase ---
FIREBASE_PROJECT_ID=
# Clave web (pública) de Firebase: el backend la usa para enviar el correo de recuperar contraseña
FIREBASE_WEB_API_KEY=
# Solo se aceptan lecturas con token de usuarios con permiso: claim ingest=true, o UIDs separados por coma
FIREBASE_INGEST_UIDS=
# Administradores (Innova Recicla): UIDs de Firebase separados por coma. Pueden cambiar el estado de los reportes.
ADMIN_UIDS=

# Solo para scripts/consultarSDK.js
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# Detrás de un proxy (Render, Railway...) para que el límite de solicitudes use la IP real
# TRUST_PROXY=1
