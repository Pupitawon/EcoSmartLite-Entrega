PORT=5000
# Cadena de conexión de Supabase (Project Settings → Database)
DATABASE_URL=postgresql://usuario:clave@host:5432/postgres
# SSL activo por defecto (Supabase lo exige). Solo para una BD local sin SSL: DATABASE_SSL=false

# Clave que debe enviar quien reporta lecturas (ESP32 / gateway).
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_API_KEY=cambia-esto-por-una-clave-larga

# Regla de alerta (%) y señal "sin reporte" (horas sin lectura)
UMBRAL_ALERTA=80
SIN_REPORTE_HORAS=6

# --- Firebase (opcional): dejar vacío para aceptar solo la API key ---
FIREBASE_PROJECT_ID=
# Solo se aceptan tokens de usuarios con permiso: claim personalizado ingest=true, o UIDs separados por coma
FIREBASE_INGEST_UIDS=

# Detrás de un proxy (Render, Railway...) para que el límite de solicitudes use la IP real
# TRUST_PROXY=1
