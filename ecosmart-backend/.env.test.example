# Copia este archivo como .env.test y cambia TU_CLAVE por la clave de tu PostgreSQL local.
# La base debe llamarse ecosmart_test (vacía). El setup BORRA su esquema: nunca apuntes a Supabase.
DATABASE_URL=postgresql://postgres:TU_CLAVE@localhost:5432/ecosmart_test
DATABASE_SSL=false
INGEST_API_KEY=clave-de-prueba-ecosmart-2026
FIREBASE_PROJECT_ID=ecosmart-test
FIREBASE_JWKS_URL=http://localhost:4999
FIREBASE_INGEST_UIDS=uid-gateway-permitido