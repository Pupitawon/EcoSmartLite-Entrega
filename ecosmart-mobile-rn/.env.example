# URL del backend. En un celular usa la IP del computador en la red (ej. http://192.168.1.20:5000), no 127.0.0.1.
EXPO_PUBLIC_API_URL=http://127.0.0.1:5000

# Configuración web de Firebase (Consola → Configuración del proyecto → Tus apps)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
