{
  "expo": {
    "name": "EcoSmart",
    "slug": "ecosmart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.inacap.ecosmart"
    },
    "android": {
      "package": "com.inacap.ecosmart",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-localization",
        {
          "locationWhenInUsePermission": "EcoSmart usa tu ubicación para mostrarte los puntos de reciclaje más cercanos mientras usas el mapa."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Usamos la cámara para escanear el QR del contenedor."
        }
      ]
    ]
  }
}